# Hermes-homelab environment — SLEUTELNAMEN alleen.
# De echte waarden staan uitsluitend in /mnt/user/appdata/hermes/data/.env (mode 600, uid 10000).
# Dit bestand wordt als sjabloon gebruikt; nooit echte secrets hier invullen.

# ── LLM provider ─────────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── Telegram ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_ALLOW_ALL_USERS=false
TELEGRAM_HOME_CHANNEL=

# ── Media-API's (interactieve agent; monitor gebruikt ze niet) ───────────
SONARR_BASE_URL=http://192.168.1.2:7854
SONARR_API_KEY=
SABNZBD_BASE_URL=http://192.168.1.2:8080
SABNZBD_API_KEY=

# ── Monitoring endpoints (geen secrets) ──────────────────────────────────
# Fase 1–3: Prometheus alleen voor historie/context.
PROMETHEUS_URL=http://192.168.1.2:9090
# Verouderd (ArrSight-snapshot); vervalt in fase 4 ten gunste van DUMBscope:
HOMELAB_SNAPSHOT_URL=http://192.168.1.2:8090/api/snapshot

# ── Hermes API-server ────────────────────────────────────────────────────
API_SERVER_KEY=

# ── Fase 4 (DUMBscope-agentendpoint; nog niet actief) ────────────────────
# DUMBSCOPE_BASE_URL=http://192.168.1.2:8091
# DUMBSCOPE_AGENT_TOKEN=
